# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) → SDK 설정 및 구성 에서 값을 복사해
# 이 파일을 .env.local 로 복사한 뒤 채워 넣으세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=reaallabout.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://reaallabout-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=reaallabout
VITE_FIREBASE_APP_ID=
